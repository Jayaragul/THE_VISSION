{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayaragul.github.io/THE_VISSION/schema/digest.schema.json",
  "title": "THE VISSION digest",
  "description": "A deterministic, no-AI edition: clustered, ranked, source-attributed headlines with no generated prose. Titles are the best source's own headline, verbatim — nothing here is written, only aggregated. See ARCHITECTURE.md section 5.5 and tools/digest.mjs.",
  "type": "object",
  "required": ["edition", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "edition": {
      "type": "object",
      "required": ["date", "generatedAt", "itemCount"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "itemCount": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "slug", "beat", "title", "confidence", "score", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "beat": { "type": "string" },
        "title": { "type": "string", "minLength": 8, "maxLength": 220 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "confidence": { "type": "string", "enum": ["confirmed", "single-source"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["title", "publisher", "url"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 8, "maxLength": 260 },
              "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "tier": { "type": "integer", "minimum": 1, "maximum": 4 }
            }
          }
        }
      }
    }
  }
}
