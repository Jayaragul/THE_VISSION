{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayaragul.github.io/THE_VISSION/schema/edition.schema.json",
  "title": "THE VISSION edition",
  "description": "One day's edition. This file is the source of truth; every published HTML page is derived from it and may be regenerated at any time.",
  "type": "object",
  "required": ["edition", "stories"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "edition": {
      "type": "object",
      "required": ["date", "number", "generatedAt", "title", "summary"],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Edition date, and the filename stem. Must match the file it lives in."
        },
        "number": { "type": "integer", "minimum": 1, "description": "Monotonic edition number." },
        "generatedAt": { "type": "string", "format": "date-time" },
        "title": {
          "type": "string",
          "minLength": 20,
          "maxLength": 120,
          "description": "The day in one line. Appears under the masthead."
        },
        "summary": {
          "type": "string",
          "minLength": 120,
          "maxLength": 600,
          "description": "Two or three sentences on the state of the day. This is the editor's note."
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "pipeline": { "type": "string" },
            "runId": { "type": "string" },
            "trigger": { "type": "string", "enum": ["manual", "schedule", "backfill"] }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/story" }
    },
    "signals": {
      "type": "object",
      "description": "Derived counters. The build recomputes these, so hand-written values are advisory only.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "story": {
      "type": "object",
      "required": ["id", "slug", "beat", "kicker", "headline", "deck", "summary", "prominence", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable permalink key: <edition-date>-<slug>. Never reused, never rewritten."
        },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "beat": { "type": "string", "description": "Must match an id in input/beats.json." },
        "kicker": { "type": "string", "minLength": 3, "maxLength": 28 },
        "headline": { "type": "string", "minLength": 30, "maxLength": 110 },
        "deck": { "type": "string", "minLength": 60, "maxLength": 220 },
        "summary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 40, "maxLength": 260 }
        },
        "body": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 120, "maxLength": 1200 },
          "description": "Required for lead/top/standard. Omitted or empty for briefs."
        },
        "whyItMatters": { "type": "string", "minLength": 80, "maxLength": 700 },
        "prominence": {
          "type": "string",
          "enum": ["lead", "top", "standard", "brief"],
          "description": "Drives layout. Exactly one lead per edition."
        },
        "publishedAt": { "type": "string", "format": "date-time", "description": "When the underlying event was reported, not when we wrote it." },
        "readMinutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "high = primary source confirms. medium = credible reporting, no primary. low = single source or contested."
        },
        "entities": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 60 } },
        "tags": { "type": "array", "maxItems": 10, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "enum": ["orbit", "strata", "lattice", "swell", "shard", "aperture", "contour", "column", "spiral", "mesh", "constellation", "weave", "terrain", "current", "fracture", "drift", "beacon", "strand"] },
            "motif": { "type": "string", "enum": ["neuralNet", "transformerStack", "weightGrid", "paperPlot", "labFlask", "growthChart", "coinStack", "scales", "institution", "serverRack", "chipDie", "coolingTowers", "powerGrid", "cityscape", "peopleNetwork", "globe"] },
            "seed": { "type": "string", "maxLength": 64 }
          },
          "description": "Optional editorial override. If absent the build derives both the background plate and a beat-appropriate pictorial motif deterministically from the story id."
        },
        "image": {
          "type": "object",
          "required": ["url", "credit"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "credit": { "type": "string" },
            "license": { "type": "string" },
            "alt": { "type": "string" }
          },
          "description": "Only for images we are licensed to display. Absent by default — the build renders original cover art instead."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 8, "maxLength": 220 },
        "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "tier": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    }
  }
}
