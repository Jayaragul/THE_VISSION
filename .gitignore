# Nothing here is generated by a package manager — the toolchain is dependency-free.
node_modules/
package-lock.json

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local Claude Code state (settings.json IS committed — it is part of the system)
.claude/settings.local.json
.claude/*.local.json

# Scratch space for research notes during a run
.scratch/
*.tmp
gate-report.txt

# The publish job downloads the research handoff artifact here. CI scratch, like the gate
# report above it — and it sits in the working tree while the allowed-paths check runs, so
# an untracked handoff/ would read as an out-of-scope change and block the publish.
handoff/
