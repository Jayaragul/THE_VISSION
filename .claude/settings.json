{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node tools/build.mjs)",
      "Bash(node tools/validate.mjs:*)",
      "Bash(node tools/edition-info.mjs:*)",
      "Bash(node tools/serve.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
